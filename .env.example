# คัดลอกเป็น .env แล้วแก้ค่า; run.ps1 โหลดไฟล์นี้อัตโนมัติ ไม่ต้องตั้งค่าทีละตัวใน PowerShell
# ค่าที่มีอยู่ใน process environment ก่อนรันจะชนะค่าในไฟล์

# --- semantic embedding แบบเลือกใช้ได้ ---
# Safe mode ไม่ใช้ LLM เขียนคำตอบ คำตอบมาจาก verified deterministic templates เท่านั้น
# หาก Ollama หรือ bge-m3 ใช้ไม่ได้ ระบบถอยไปค้นความหมายด้วย trigram
IRFA_LLM_BASE=http://127.0.0.1:11434
IRFA_EMBED_MODEL=bge-m3:latest
IRFA_EMBED_BATCH=16
IRFA_EMBED_TIMEOUT=120
# เวลารอ semantic query ต่อคำถาม และช่วงพักก่อนลอง Ollama ใหม่หลังล้มเหลว
IRFA_SEMANTIC_QUERY_TIMEOUT=2
IRFA_SEMANTIC_RETRY_SECONDS=30

# --- ขีดจำกัดการใช้งาน ---
IRFA_MAX_QUESTION=400
IRFA_MAX_HISTORY=8
IRFA_MAX_HISTORY_ITEM=400
# ขนาดสูงสุดของ JSON/request body ทั่วไป; endpoint PDF มีเพดานแยก
IRFA_MAX_REQUEST_BODY_BYTES=65536
IRFA_RATE_LIMIT=12
IRFA_RATE_WINDOW=60
# จำกัดซ้ำตาม IP เพื่อกันการเปลี่ยน persona/X-User-Id หลบโควตา
IRFA_CLIENT_RATE_LIMIT=12
IRFA_CLIENT_RATE_WINDOW=60
IRFA_MAX_FEEDBACK_QUESTION=400
IRFA_MAX_FEEDBACK_ANSWER=8000
IRFA_MAX_FEEDBACK_NOTE=400
IRFA_FEEDBACK_RATE_LIMIT=8
IRFA_FEEDBACK_RATE_WINDOW=60
IRFA_FEEDBACK_CLIENT_RATE_LIMIT=8
IRFA_FEEDBACK_CLIENT_RATE_WINDOW=60
# จำนวน identity/IP bucket สูงสุดในหน่วยความจำต่อ limiter
IRFA_RATE_BUCKET_CAP=2048

# --- ขอบเขตเว็บ ---
# ระบุ host/IP ที่รับได้แบบเจาะจง ห้ามใช้ *; testserver ทำให้ TestClient รันชุดทดสอบได้
IRFA_TRUSTED_HOSTS=127.0.0.1,localhost,testserver
# เปิดเฉพาะเมื่อ reverse proxy ที่ยืนยัน session แล้วเป็นผู้เขียน X-User-Id
IRFA_TRUST_PROXY_USER=off
# ใช้เฉพาะเมื่อ IRFA_TRUST_PROXY_USER=on ต้องเป็น IP แบบเจาะจงของ proxy เท่านั้น
IRFA_TRUSTED_PROXY_IPS=127.0.0.1,::1
# โหมดเปิดให้เพื่อนผ่าน run.ps1 จะปิดสองค่านี้เอง แม้ .env จะเปิดอยู่
IRFA_EXPOSE_DOCS=on
IRFA_ADMIN_ENABLED=on

# --- ผู้ใช้และการตรวจข้อมูล ---
IRFA_PROFILE_SOURCE=demo
IRFA_AUDIT=on
# ปีงบเริ่มต้นเมื่อคำถามไม่ระบุปี; คำว่า ปีนี้/ปีหน้า คำนวณตามเวลา Asia/Bangkok ทุก request
IRFA_FISCAL_YEAR=2569
# จำนวนแถวสูงสุดที่ /v1/recent อ่านกลับ; บรรทัด log เสียหรือเขียนค้างจะถูกข้าม
IRFA_AUDIT_MAX_TAIL=200
# หมุนไฟล์ก่อนเกิน 10 MiB เก็บย้อนหลัง 1 ไฟล์ และอ่านท้ายไฟล์แบบจำกัดหน่วยความจำ
IRFA_AUDIT_MAX_BYTES=10485760
IRFA_AUDIT_BACKUPS=1
IRFA_AUDIT_TAIL_READ_BYTES=2097152
# ตั้งค่านี้เมื่อจะเปิดหน้า /admin สุ่มมาเองยาว ๆ อย่าใช้ค่าตัวอย่างนี้
IRFA_ADMIN_TOKEN=
# หาก PDF ต้นฉบับไม่ได้อยู่ที่ ../../IRFA/resource/Docs/Seminar_resource/Funds_resource
# ให้กำหนดพาธเต็มของโฟลเดอร์ที่มีประกาศ 4 ฉบับ เช่น IRFA_SOURCE_DIR=C:/data/Funds_resource
# พื้นที่กักกัน PDF ที่อัปโหลดใหม่และข้อมูลฉบับร่าง (หากเว้นว่างใช้ data/ingestion)
# งานนี้ยังไม่ใช่คลังคำตอบและจะไม่ตั้ง verified/published ให้อัตโนมัติ
IRFA_INGESTION_DIR=
# โควตานับเฉพาะ PDF ต้นฉบับในพื้นที่กักกัน; ต้องเป็นจำนวนเต็มบวก
IRFA_INGESTION_MAX_DOCUMENTS=100
IRFA_INGESTION_MAX_TOTAL_BYTES=536870912

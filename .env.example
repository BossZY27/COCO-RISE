# คัดลอกเป็น .env แล้วแก้ค่า; run.ps1 โหลดไฟล์นี้อัตโนมัติ ไม่ต้องตั้งค่าทีละตัวใน PowerShell
# ค่าที่มีอยู่ใน process environment ก่อนรันจะชนะค่าในไฟล์

# --- โหมดการสร้างคำตอบและโมเดลภาษา (LLM RAG / Typed Claim / Verified Template) ---
# RISE_ANSWER_MODE=llm              -> ใช้โมเดล (เช่น qwen3:4b) เขียนคำตอบ RAG จากหลักฐานที่ตรวจแล้ว + Verifier ตรวจทุกครั้ง
# RISE_ANSWER_MODE=typed_claim      -> ใช้โมเดลสกัด Typed Claim JSON จากหลักฐานที่ตรวจแล้ว + Verifier ตรวจทุกครั้ง
# RISE_ANSWER_MODE=verified_template -> ใช้เฉพาะ deterministic template (ไม่เรียก LLM ตอนตอบ)
RISE_ANSWER_MODE=llm
RISE_SLOT_LLM_FALLBACK=on
RISE_LLM_SMALL=qwen3:4b
RISE_LLM_BASE=http://127.0.0.1:11434
RISE_EMBED_MODEL=bge-m3:latest
RISE_EMBED_BATCH=16
RISE_EMBED_TIMEOUT=120
# เวลารอ semantic query ต่อคำถาม และช่วงพักก่อนลอง Ollama ใหม่หลังล้มเหลว
RISE_SEMANTIC_QUERY_TIMEOUT=2
RISE_SEMANTIC_RETRY_SECONDS=30

# --- ขีดจำกัดการใช้งาน ---
RISE_MAX_QUESTION=400
RISE_MAX_HISTORY=8
RISE_MAX_HISTORY_ITEM=400
# ขนาดสูงสุดของ JSON/request body ทั่วไป; endpoint PDF มีเพดานแยก
RISE_MAX_REQUEST_BODY_BYTES=65536
RISE_RATE_LIMIT=12
RISE_RATE_WINDOW=60
# จำกัดซ้ำตาม IP เพื่อกันการเปลี่ยน persona/X-User-Id หลบโควตา
RISE_CLIENT_RATE_LIMIT=12
RISE_CLIENT_RATE_WINDOW=60
RISE_MAX_FEEDBACK_QUESTION=400
RISE_MAX_FEEDBACK_ANSWER=8000
RISE_MAX_FEEDBACK_NOTE=400
RISE_FEEDBACK_RATE_LIMIT=8
RISE_FEEDBACK_RATE_WINDOW=60
RISE_FEEDBACK_CLIENT_RATE_LIMIT=8
RISE_FEEDBACK_CLIENT_RATE_WINDOW=60
# จำนวน identity/IP bucket สูงสุดในหน่วยความจำต่อ limiter
RISE_RATE_BUCKET_CAP=2048

# --- ขอบเขตเว็บ ---
# ระบุ host/IP ที่รับได้แบบเจาะจง ห้ามใช้ *; testserver ทำให้ TestClient รันชุดทดสอบได้
RISE_TRUSTED_HOSTS=127.0.0.1,localhost,testserver
# เปิดเฉพาะเมื่อ reverse proxy ที่ยืนยัน session แล้วเป็นผู้เขียน X-User-Id
RISE_TRUST_PROXY_USER=off
# ใช้เฉพาะเมื่อ RISE_TRUST_PROXY_USER=on ต้องเป็น IP แบบเจาะจงของ proxy เท่านั้น
RISE_TRUSTED_PROXY_IPS=127.0.0.1,::1
# โหมดเปิดให้เพื่อนผ่าน run.ps1 จะปิดสองค่านี้เอง แม้ .env จะเปิดอยู่
RISE_EXPOSE_DOCS=on
RISE_ADMIN_ENABLED=on

# --- ผู้ใช้และการตรวจข้อมูล ---
RISE_PROFILE_SOURCE=demo
RISE_AUDIT=on
# ปีงบเริ่มต้นเมื่อคำถามไม่ระบุปี; คำว่า ปีนี้/ปีหน้า คำนวณตามเวลา Asia/Bangkok ทุก request
RISE_FISCAL_YEAR=2569
# จำนวนแถวสูงสุดที่ /v1/recent อ่านกลับ; บรรทัด log เสียหรือเขียนค้างจะถูกข้าม
RISE_AUDIT_MAX_TAIL=200
# หมุนไฟล์ก่อนเกิน 10 MiB เก็บย้อนหลัง 1 ไฟล์ และอ่านท้ายไฟล์แบบจำกัดหน่วยความจำ
RISE_AUDIT_MAX_BYTES=10485760
RISE_AUDIT_BACKUPS=1
RISE_AUDIT_TAIL_READ_BYTES=2097152
# ตั้งค่านี้เมื่อจะเปิดหน้า /admin สุ่มมาเองยาว ๆ อย่าใช้ค่าตัวอย่างนี้
RISE_ADMIN_TOKEN=
# หาก PDF ต้นฉบับไม่ได้อยู่ที่ ../../RISE/resource/Docs/Seminar_resource/Funds_resource
# ให้กำหนดพาธเต็มของโฟลเดอร์ที่มีประกาศ 4 ฉบับ เช่น RISE_SOURCE_DIR=C:/data/Funds_resource
# พื้นที่กักกัน PDF ที่อัปโหลดใหม่และข้อมูลฉบับร่าง (หากเว้นว่างใช้ data/ingestion)
# งานนี้ยังไม่ใช่คลังคำตอบและจะไม่ตั้ง verified/published ให้อัตโนมัติ
RISE_INGESTION_DIR=
# โควตานับเฉพาะ PDF ต้นฉบับในพื้นที่กักกัน; ต้องเป็นจำนวนเต็มบวก
RISE_INGESTION_MAX_DOCUMENTS=100
RISE_INGESTION_MAX_TOTAL_BYTES=536870912

# PostgreSQL สำหรับรัน API/worker จากเครื่อง; Docker Compose กำหนด URL ภายใน container เอง
RISE_DATABASE_URL=postgresql+psycopg://rise:rise-local-only@127.0.0.1:5432/rise
RISE_FILES_DIR=data/private
RISE_SOURCE_DIR=funds-data
RISE_ANSWER_ENABLED=true
